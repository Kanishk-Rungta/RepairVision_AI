// =============================================================================
//  The Circularity Repair Cafe Hub on Cloudflare
//  ---------------------------------------------------------------------------
//  One Worker serves the whole site: the pages, the API, the photos and the
//  hourly jobs.
//
//  The Worker name and the two resource ids below belong to RepairVision's
//  own Cloudflare account. Everything else works for any cafe as it is.
// =============================================================================
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // RepairVision's live site:
  // https://repair-cafe-hub.circularity-cloudflare.workers.dev
  // (<name>.<account subdomain>.workers.dev).
  "name": "repair-cafe-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // The web app's static files: scripts, styles, fonts and images. Requests
  // for these are answered by Cloudflare directly, without running the Worker,
  // so they cost no CPU time at all.
  "assets": {
    "directory": "../web/.svelte-kit/cloudflare",
    "binding": "ASSETS"
  },

  // The cafe's own web address is not set here, so this file works for any
  // cafe. Pass it the first time you publish instead:
  //   pnpm cf:deploy -- --domain repair.example.org
  // Cloudflare then creates the DNS record and the HTTPS certificate. The
  // domain must already be on your Cloudflare account. Until then the hub is
  // also reachable at <name>.<your-subdomain>.workers.dev.
  "workers_dev": true,

  // Where the Worker runs. By default a request runs in the Cloudflare data
  // centre nearest the visitor, and the Gemini API then sees that location.
  // Google refuses Gemini calls from some places (Hong Kong among them), and
  // Cloudflare routes many Indian ISPs through Hong Kong, so AI Diagnosis and
  // the site assistant failed for those visitors with "User location is not
  // supported for the API use". Pinning the Worker near Google Cloud's Mumbai
  // region keeps every call in a supported location and close to the cafe's
  // visitors. Static files are still served from the nearest data centre.
  "placement": { "region": "gcp:asia-south1" },

  // The database and the uploads store, pinned by id to the ones already on
  // RepairVision's Cloudflare account, so every deploy (even after renaming
  // the Worker) reuses them rather than creating empty ones. A fresh account
  // should remove the two ids: the first `wrangler deploy` then creates both.
  "d1_databases": [
    { "binding": "DB", "database_name": "repair-cafe-hub", "database_id": "4888c9d1-dc70-4151-acfc-90de865ff9fa" }
  ],
  // Photos and other uploads. This account keeps them in Workers KV, which
  // needs no payment method (src/lib/kvUploads.ts). With R2 enabled on the
  // account, R2 is the better home: swap the kv_namespaces line for
  //   "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "repair-cafe-hub-uploads" }],
  // Uploads already in KV are not moved across; take a backup first.
  "kv_namespaces": [{ "binding": "UPLOADS_KV", "id": "3e73761fee5c4dc8bc8a675e78bd41b5" }],

  // The hourly jobs (telemetry if agreed, the update check, refreshing the
  // Repair Cafe directory) run after ordinary visits, so no cron trigger is
  // needed. The free plan allows only five per account. If you have one to
  // spare, add  "triggers": { "crons": ["17 * * * *"] }  here as well.
  // See src/housekeeping.ts.

  // Settings such as TZ (where your cafe is) are not written here. Set them in
  // the Cloudflare dashboard: Workers & Pages, repair-cafe-hub, Settings,
  // Variables and Secrets. Every setting has a sensible default, and
  // "keep_vars" stops a publish from wiping what you set there.
  "keep_vars": true,

  // Bundle .wasm (the picture renderer) and .ttf (its fonts) as modules.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],

  "observability": { "enabled": true },

  // The project's public demo site, published with  pnpm demo:deploy.  It has
  // its own Worker, database and bucket, so it never touches a real cafe. It
  // also needs a secret, DEMO_RESET_KEY, which lets demo/seed.py wipe and refill
  // it every hour. A cafe can ignore this section.
  "env": {
    "demo": {
      "name": "repair-cafe-demo",
      "d1_databases": [{ "binding": "DB", "database_name": "repair-cafe-demo" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "repair-cafe-demo-uploads" }],
      "vars": {
        "TZ": "Europe/London",
        "DEMO_MODE": "true",
        "TELEMETRY_DISABLED": "true"
      }
    }
  }
}
