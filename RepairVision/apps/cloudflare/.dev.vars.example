# Local secrets for `pnpm cf:dev` (wrangler dev). Copy this file to .dev.vars
# in the same folder and fill in your own values. .dev.vars is git-ignored:
# never commit a real key.
#
# RepairVision AI Diagnosis and the site assistant (the chat character):
# a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. The model defaults to gemma-4-26b-a4b-it.
# GEMMA_MODEL=gemma-4-26b-a4b-it
# "high" (default, better reasoning, slower) or "minimal" (faster).
# GEMMA_THINKING_LEVEL=high
# Set to false if the API refuses JSON mode for your model.
# GEMMA_JSON_MODE=true
# How long to wait for Gemma, in milliseconds. Default 90000.
# GEMMA_TIMEOUT_MS=90000
# Diagnosis requests per signed-in person per hour. Default 30.
# AI_DIAGNOSIS_HOURLY_LIMIT=30
# Questions one visitor may ask the site assistant per hour. Default 20.
# AI_CHAT_HOURLY_LIMIT=20

# Demo data: after `python demo/seed.py --base-url http://localhost:8787`
# (python3 on macOS/Linux), "true" shows one-click buttons for the demo admin,
# repairer and device owner on the sign-in and sign-up pages. Never set this
# on a real cafe's hub.
# DEMO_ACCOUNTS=true

# Repair vs. Replace Advisor: live part prices. Optional. Without these the
# advisor still finds part names and iFixit store links, and the person types in
# the price. The URL must be https; the contract is in
# src/services/advisor/parts.ts. The key is a secret.
# PARTS_PRICE_API_URL=
# PARTS_PRICE_API_KEY=
